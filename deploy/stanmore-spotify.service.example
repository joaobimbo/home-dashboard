# Install as ~/.config/systemd/user/stanmore-spotify.service, replacing the
# Bluetooth address with your own. Local output follows the default PipeWire sink. Enable with:
# systemctl --user daemon-reload && systemctl --user enable --now stanmore-spotify
[Unit]
Description=Spotify Connect player for Bluetooth speaker
After=pipewire-pulse.service
Wants=pipewire-pulse.service

[Service]
ExecStartPre=-/usr/bin/bluetoothctl --timeout 15 connect 54:B7:E5:B9:C4:EA
ExecStart=/usr/bin/librespot --name "Stanmore" --backend pulseaudio --device-type speaker --cache %h/.cache/stanmore-spotify --disable-audio-cache --initial-volume 35
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
