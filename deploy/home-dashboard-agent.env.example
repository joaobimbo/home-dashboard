TELEGRAM_BOT_TOKEN=replace-with-botfather-token
TELEGRAM_ALLOWED_CHAT_IDS=-1001234567890

# openai, anthropic, or gemini
LLM_PROVIDER=openai
LLM_MODEL=replace-with-a-structured-output-capable-model

# Only the selected provider's key is required.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

AGENT_DATA_DIR=/var/lib/home-dashboard-agent
DASHBOARD_URL=http://127.0.0.1:5000
AGENT_TIMEZONE=Europe/Lisbon
AGENT_LOG_LEVEL=INFO
AGENT_MAX_MESSAGE_AGE_SECONDS=3600
